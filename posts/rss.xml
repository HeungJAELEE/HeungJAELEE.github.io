      <pubDate>Thu, 09 Jul 2026 00:00:00 +0900</pubDate>
      
      <guid>https://heungjaelee.github.io/posts/giga-press-dx/</guid>
      <description>&lt;aside class=&#34;project-case-summary project-case-summary--dx&#34; aria-labelledby=&#34;project-case-summary-giga-press-dx&#34; data-project-id=&#34;giga-press-dx&#34;&gt;
