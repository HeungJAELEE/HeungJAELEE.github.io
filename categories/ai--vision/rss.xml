        &lt;span class=&#34;project-resources__label&#34;&gt;GitHub 프로젝트 목록&lt;/span&gt;
        &lt;span class=&#34;project-resources__url&#34;&gt;github.com/HeungJAELEE&lt;/span&gt;
      &lt;/a&gt;
    &lt;/li&gt;
    &lt;li&gt;
      &lt;a href=&#34;https://www.canva.com/design/DAHGaCTGRFs/0GKq7g9dsbb_ANIeRv8dnQ/edit?ui=eyJEIjp7IlAiOnsiQiI6ZmFsc2V9fX0&#34; target=&#34;_blank&#34; rel=&#34;noopener&#34;&gt;
