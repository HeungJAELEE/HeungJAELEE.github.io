&lt;thead&gt;
&lt;tr&gt;
&lt;th&gt;분석대상&lt;/th&gt;
&lt;th&gt;추정원인&lt;/th&gt;
&lt;th&gt;확인결과&lt;/th&gt;
&lt;th&gt;조치사항&lt;/th&gt;
&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td&gt;Etching·전처리&lt;/td&gt;
&lt;td&gt;Man·Method·Measurement — 작업순서·검사시점·Sample 이력 분리&lt;/td&gt;
&lt;td&gt;피막두께·조도·외관·후공정 대조&lt;/td&gt;
&lt;td&gt;Process Flow·Run Sheet Sequence 재정렬&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Bead Blast&lt;/td&gt;
&lt;td&gt;Machine·Method·Measurement — 제품군별 표면요구 미반영&lt;/td&gt;
&lt;td&gt;조도·외관·Particle 비교&lt;/td&gt;
